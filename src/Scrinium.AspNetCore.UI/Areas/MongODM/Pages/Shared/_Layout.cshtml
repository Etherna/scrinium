@inject Etherna.MongODM.AspNetCore.UI.DashboardOptions dashboardOptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MongODM Dashboard</title>
    <link rel="stylesheet" href="~/_content/Etherna.Scrinium.AspNetCore.UI/css/mongodmDash.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" asp-area="MongODM" asp-page="/Index">MongODM <span>Dashboard</span></a>
            @if (!string.IsNullOrEmpty(dashboardOptions.AppPath))
            {
                <a class="back-link" href="@dashboardOptions.AppPath">Back to site</a>
            }
        </div>
    </header>
    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; Etherna SA
        </div>
    </footer>

    <script src="~/_content/Etherna.Scrinium.AspNetCore.UI/js/mongodmDash.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
